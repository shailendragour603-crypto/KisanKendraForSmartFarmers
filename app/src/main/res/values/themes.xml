<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- We use transparent so the Native Splash Screen doesn't flash. Our Extended Splash Screen handles everything. -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme_KisanKendra_NoActionBar</item>
    </style>

    <style name="Theme_KisanKendra_NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="chipStyle">@style/AppChipStyle</item>

        <!-- Custom Compact Popup Container & Dropdown Styling -->
        <item name="android:popupBackground">@drawable/bg_compact_popup</item>
        <item name="popupMenuBackground">@drawable/bg_compact_popup</item>
        <item name="android:itemBackground">#242428</item>
        <item name="android:itemTextAppearance">@style/CompactPopupMenuTextAppearance</item>
        <item name="autoCompleteTextViewStyle">@style/CompactAutoCompleteTextView</item>
        <item name="dropDownListViewStyle">@style/CompactDropDownListView</item>

        <!-- Disable Material 3 Dynamic Purple Elevation Surface Tint -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/white</item>
    </style>
</resources>
