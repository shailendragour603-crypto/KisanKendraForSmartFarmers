<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar with Neon Logo & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_kisan_ai_logo"
            android:contentDescription="Kisan AI Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#00FF66"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:text="Kisan AI - Smart Assistant"
                android:textColor="#00FF66"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRemainingQuestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Questions left today: 5/5"
                android:textColor="#00E5FF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#94A3B8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="8dp" />

    <!-- Modern Quick Prompt Chips (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrompt1"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🌱 फसल रोग और उपचार"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E293B"
                app:chipStrokeColor="#00FF66"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrompt2"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="💧 सिंचाई का सही तरीका"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E293B"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrompt3"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="🌾 खाद और उर्वरक सुझाव"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E293B"
                app:chipStrokeColor="#00FF66"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrompt4"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 मंडी भाव और सलाह"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E293B"
                app:chipStrokeColor="#00E5FF"
                app:chipStrokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages RecyclerView -->
    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarChat"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminateTint="#00FF66"
        android:visibility="gone" />

    <!-- Selected Image Preview Container -->
    <LinearLayout
        android:id="@+id/layoutImagePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_neon_card"
        android:visibility="gone"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/ivSelectedImagePreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:contentDescription="Selected Crop Image" />

        <TextView
            android:id="@+id/tvImagePreviewLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="📷 Crop Photo Attached"
            android:textColor="#00FF66"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRemoveSelectedImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove Image"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FF5252" />
    </LinearLayout>

    <!-- Fixed Chat Banner Ad Container (Non-Intrusive) -->
    <FrameLayout
        android:id="@+id/adContainerChatBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Input Bar with Attach Image, Mic & Send Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnAttachImage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neon_pill"
            android:contentDescription="Attach Crop Image"
            android:src="@drawable/ic_camera_vector"
            app:tint="#00FF66" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_neon_pill"
            android:contentDescription="Microphone Voice Input"
            android:src="@drawable/ic_mic_vector"
            app:tint="#00FF66" />

        <EditText
            android:id="@+id/etUserQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_neon_pill"
            android:hint="Ask Kisan AI anything..."
            android:inputType="textLongMessage|textAutoComplete|textCapSentences"
            android:maxLines="3"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_neon_pill"
            android:contentDescription="Send Query"
            android:src="@drawable/ic_send_vector"
            app:tint="#00E5FF" />
    </LinearLayout>

</LinearLayout>
