<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/active_bg_shape"
    android:backgroundTint="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- Bottom Sheet Drag Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#D1D5DB" />

    <!-- User Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPostDialogAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="User Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_avatar"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="@color/farmer_green_primary"
            app:strokeWidth="1.5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPostDialogUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farmer Community Post"
                android:textColor="@color/farmer_green_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Public • Kisan Kendra Farmers"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Scrollable Bullet Chips for Category Selection -->
    <TextView
        android:id="@+id/tvSelectCategoryHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Category:"
        android:textColor="@color/farmer_green_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDialogCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogGeneral"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="सामान्य खेती" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogDiseases"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="फसल बीमारियां" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogFertilizers"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="खाद व उर्वरक" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogMandi"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="मंडी सलाह" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogSchemes"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="सरकारी योजनाएं" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogSeeds"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="बीज एवं किस्म" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogOrganic"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="जैविक खेती" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogMachinery"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="मशीनरी व ट्रैक्टर" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogWeather"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="मौसम" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDialogDairy"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="पशुपालन व डेयरी" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Hidden Legacy AutoCompleteTextView to maintain binding compatibility -->
    <AutoCompleteTextView
        android:id="@+id/actvDialogCategory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Main Multiline Text Box: "What's on your mind?" -->
    <EditText
        android:id="@+id/etDialogQuestionDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:maxLines="6"
        android:gravity="top|start"
        android:background="@drawable/bg_input_pill"
        android:padding="14dp"
        android:hint="@string/forum_post_hint"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="15sp"
        android:layout_marginBottom="10dp" />

    <!-- Optional Media Attachment Preview Box -->
    <FrameLayout
        android:id="@+id/layoutMediaPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivDialogMediaPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_badge_green"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvMediaBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#80000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="संलग्न फ़ोटो/वीडियो"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRemoveMedia"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_green"
            android:contentDescription="Remove Media"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#D32F2F" />
    </FrameLayout>

    <!-- Scrollable Action Toolbar for Camera, Video, Photo Gallery -->
    <TextView
        android:id="@+id/tvMediaHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Media to post:"
        android:textColor="@color/farmer_green_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Take Live Photo / Camera -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogCamera"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#FCE4EC"
                android:paddingHorizontal="10dp"
                android:text="लाइव फ़ोटो"
                android:textColor="#C2185B"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_camera_vector"
                app:iconTint="#C2185B" />

            <!-- Record Live Video / Reel -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogVideo"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#FBE9E7"
                android:paddingHorizontal="10dp"
                android:text="वीडियो बनाएं"
                android:textColor="#D84315"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_video_outline"
                app:iconTint="#D84315" />

            <!-- Gallery Photo -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogGalleryPhoto"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:text="गैलरी फ़ोटो"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_gallery_vector"
                app:iconTint="#2E7D32" />

            <!-- Gallery Video -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogGalleryVideo"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#E3F2FD"
                android:paddingHorizontal="10dp"
                android:text="गैलरी वीडियो"
                android:textColor="#1565C0"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_video_library"
                app:iconTint="#1565C0" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Tight Action Buttons Row: Save Draft & Post -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDraft"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Save Draft"
            android:textColor="@color/farmer_green_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="22dp"
            app:strokeColor="@color/farmer_green_dark"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitQuestion"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/farmer_green_dark"
            android:text="Post"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="22dp" />
    </LinearLayout>

</LinearLayout>
