<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivExpenseCategoryIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_expense_seeds"
            android:contentDescription="Expense Category Icon" />

        <TextView
            android:id="@+id/tvExpenseCategoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Seeds"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvExpenseCategoryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹18,500"
            android:textColor="@color/price_min_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExpenseCategoryPercent"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:text="15%"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressExpenseCategory"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="38dp"
        app:trackColor="@color/card_stroke_color"
        app:indicatorColor="@color/price_min_text"
        app:trackCornerRadius="3dp"
        android:progress="15" />
</LinearLayout>
