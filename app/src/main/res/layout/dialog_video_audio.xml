<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#212121"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎵 Audio &amp; Music Options"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Two Buttons: Add MP3 / Extract from Video -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAddAudio"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:drawableStart="@drawable/ic_music"
            android:drawablePadding="6dp"
            android:text="Add Audio (MP3)"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:strokeColor="@color/farmer_green_primary" />

        <Button
            android:id="@+id/btnExtractAudio"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:drawableStart="@drawable/ic_video_library"
            android:drawablePadding="6dp"
            android:text="Extract from Video"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:strokeColor="@color/farmer_green_primary" />
    </LinearLayout>

    <!-- Selected Audio Details Card -->
    <LinearLayout
        android:id="@+id/layoutSelectedAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#2A2A2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_music"
            app:tint="@color/farmer_green_primary" />

        <TextView
            android:id="@+id/tvAudioName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Selected Audio Track"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnRemoveAudio"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove audio"
            android:src="@drawable/ic_delete"
            app:tint="#FF5252" />
    </LinearLayout>

    <!-- Section: Added Audio Controls (Volume & Start Offset) -->
    <LinearLayout
        android:id="@+id/layoutAudioControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Volume Adjustment Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="85dp"
                android:layout_height="wrap_content"
                android:text="Track Volume"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBarAudioVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="100" />

            <TextView
                android:id="@+id/tvAudioVolumeVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100%"
                android:textColor="@color/farmer_green_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Audio Start Offset / Trim Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="85dp"
                android:layout_height="wrap_content"
                android:text="Music Start"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBarAudioStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvAudioStartVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mute Original Video Audio Checkbox -->
    <CheckBox
        android:id="@+id/cbMuteOriginalAudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Mute Original Video Audio"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnDoneAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/farmer_green_primary"
        android:text="Done"
        android:textColor="@android:color/white" />

</LinearLayout>
