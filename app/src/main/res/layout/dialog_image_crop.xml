<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#212121"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✂️ Crop &amp; Aspect Ratio"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Aspect Ratio Selection Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Aspect Ratio Preset"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupImageRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRatioFree"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Free Crop"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#333333" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRatio11"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1:1 (Square)"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#333333" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRatio45"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:5 (Portrait)"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#333333" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRatio916"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:16 (Story/Reel)"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#333333" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRatio169"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:9 (Landscape)"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#333333" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Rotate & Flip Options -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Rotate &amp; Flip"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRotateRight"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:drawableStart="@drawable/ic_rotate_right"
            android:drawablePadding="6dp"
            android:text="Rotate 90°"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:strokeColor="#555555" />

        <Button
            android:id="@+id/btnFlipHorizontal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Flip Horizontal"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:strokeColor="#555555" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDoneCrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/farmer_green_primary"
        android:text="Done"
        android:textColor="@android:color/white" />

</LinearLayout>
