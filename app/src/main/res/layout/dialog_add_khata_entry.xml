<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvKhataDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 नई एन्ट्री जोड़ें"
            android:textColor="@color/farmer_green_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Type Selector: Expense (-) vs Income (+) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleKhataType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:checkedButton="@id/btnTypeExpense"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeExpense"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="💸 खर्च (-)"
                android:textColor="#C62828"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTypeIncome"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="💰 आय (+)"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:textStyle="bold" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Amount Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKhataAmount"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="राशि"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKhataAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:textColorHint="#64748B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Crop Season Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKhataCrop"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="फसल का मौसम चुनें"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/actvKhataCrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="#1E293B"
                android:textColorHint="#64748B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKhataCategory"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="श्रेणी"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/actvKhataCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="#1E293B"
                android:textColorHint="#64748B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Crop Stage Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKhataStage"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="फसल का चरण"
            android:layout_marginBottom="12dp">

            <AutoCompleteTextView
                android:id="@+id/actvKhataStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="#1E293B"
                android:textColorHint="#64748B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Note/Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKhataNote"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="नोट / विवरण"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKhataNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="#1E293B"
                android:textColorHint="#64748B" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKhataCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="रद्द करें" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKhataSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/farmer_green_dark"
                android:text="एन्ट्री सहेजें" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
