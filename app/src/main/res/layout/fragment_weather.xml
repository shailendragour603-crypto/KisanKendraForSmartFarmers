<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_farmer_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Screen Alert Banner -->
    <include
        android:id="@+id/alertBanner"
        layout="@layout/layout_screen_alert_banner" />

    <!-- Top Location Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWeatherSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Location Icon"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/farmer_green_primary" />

            <AutoCompleteTextView
                android:id="@+id/actvWeatherLocationSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:completionThreshold="1"
                android:hint="Search City or Village..."
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingVertical="8dp"
                android:popupBackground="@drawable/bg_weather_search_dropdown"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnGpsLocation"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="GPS Current Location"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="@color/farmer_green_primary" />

            <ImageButton
                android:id="@+id/btnRefreshWeather"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh Weather"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/farmer_green_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshWeather"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollViewWeather"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 🔹 SECTION 1: TODAY'S WEATHER HERO CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeatherHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:cardBackgroundColor="@color/weather_hero_card_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/green_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Header Row 1: Location Pin, Location Name & Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivHeroLocationPin"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvHeroLocationName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Kishore Nagar, Khandwa" />

                        <TextView
                            android:id="@+id/tvTodayDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="#C8E6C9"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="03 Oct, 2026" />
                    </LinearLayout>

                    <!-- Header Row 2: Subtitle Label ("Current Weather") -->
                    <TextView
                        android:id="@+id/tvTodayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Current Weather"
                        android:textColor="#E8F5E9"
                        android:textSize="12sp" />

                    <!-- Main Weather Display Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Left Column: Temperature, Status, High/Low -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:orientation="vertical">

                            <!-- Temperature (Shifted to Left) -->
                            <TextView
                                android:id="@+id/tvTodayTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="23°C"
                                android:textColor="@android:color/white"
                                android:textSize="48sp"
                                android:textStyle="bold" />

                            <!-- Weather Status (Shifted to Left) -->
                            <TextView
                                android:id="@+id/tvTodayCondition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="☀️ Clear Sunny"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- High / Low (Shifted to Left) -->
                            <TextView
                                android:id="@+id/tvTodayMinMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="High: 33°C • Low: 22°C"
                                android:textColor="#C8E6C9"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Big Size Animated Vector Icon (Fills Center/Right Area) -->
                        <ImageView
                            android:id="@+id/ivWeatherAnimIcon"
                            android:layout_width="170dp"
                            android:layout_height="170dp"
                            android:layout_marginStart="-4dp"
                            android:contentDescription="Weather Status Icon"
                            android:padding="2dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_weather_sun"
                            app:tint="#FFD54F" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:background="#388E3C" />

                    <!-- 4 Agricultural Metrics Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <!-- Rain % -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRainHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌧️ Rain"
                                android:textColor="#C8E6C9"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvRainChance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="20%"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Humidity -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHumidityHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💧 Humidity"
                                android:textColor="#C8E6C9"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="68%"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Wind -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvWindHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💨 Wind"
                                android:textColor="#C8E6C9"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvWindSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="14 km/h"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- UV Index -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUvHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☀️ UV Index"
                                android:textColor="#C8E6C9"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvUvIndex"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="6 Mod"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 🔹 SECTION 2: FARMER WEATHER ADVISORY CARDS -->
            <TextView
                android:id="@+id/tvAdvisorySectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="🌾 Agricultural Weather Advisory"
                android:textColor="@color/farmer_green_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Spraying Advisory Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚜"
                        android:textSize="28sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSprayAdvisoryHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pesticide Spray Advisory"
                            android:textColor="@color/farmer_green_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSprayAdvisory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="✅ Favorable conditions for spraying today. Low wind and low rain risk."
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Irrigation Advisory Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧"
                        android:textSize="28sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvIrrigationAdvisoryHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Crop Irrigation Advisory"
                            android:textColor="@color/farmer_green_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvIrrigationAdvisory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="🌾 Normal soil moisture. Light irrigation recommended in the afternoon."
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 🔹 SECTION 3: UPCOMING 6-DAY FORECAST LIST -->
            <TextView
                android:id="@+id/tvForecastSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="📅 Upcoming 6-Day Weather Forecast"
                android:textColor="@color/farmer_green_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbForecast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvForecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="80dp" />

        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>