<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="Full Resolution Image"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/btnCloseFullMedia"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_badge_green"
        android:contentDescription="Close Viewer"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        app:tint="@color/farmer_green_dark" />

</FrameLayout>
